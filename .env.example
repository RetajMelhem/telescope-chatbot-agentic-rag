# General settings template, without secrets. The default factory fails closed.
# run-mvp.ps1 / run-local.ps1 explicitly select the working local MVP profile.
# Their fixed runtime overrides are documented in docs/LOCAL_MVP.md.
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CLINIC_TIMEZONE=Asia/Amman
DEFAULT_LANGUAGE=ar
CORS_ALLOWED_ORIGINS=https://telescopecenter.com,https://www.telescopecenter.com

# Paste a real key only into your local .env, never into this example.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-6-luna
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Luna does not require a local counter. Missing provider usage remains unknown.
CHAT_INPUT_ACCOUNTING=reported_usage
# Optional development experiment; omit to preserve the provider's reasoning default.
# CHAT_REASONING_EFFORT=none
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MAX_RETRIES=1
PROVIDER_MAX_REQUEST_BYTES=262144
PROVIDER_MAX_RESPONSE_BYTES=2000000
PROVIDER_RETRY_DELAY_SECONDS=0.1
MAX_EMBEDDING_CALLS=1
MAX_EMBEDDING_INPUT_TOKENS=16000
MAX_EMBEDDING_BATCH_SIZE=32

# Host default. The explicit local container pins http://telescope-m3-qdrant:6333.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_ALIAS=telescope_public_active
EMBEDDING_DIMENSIONS=4096

# General defaults below; local MVP overrides retries, timeouts, retrieval pool
# and output allowance in src/telescope_rag/api/local.py (not by changing .env).
MAX_QUERY_CHARS=4000
MAX_HISTORY_MESSAGES=6
MAX_HISTORY_CHARS=8000
MAX_SUBQUESTIONS=4
MAX_LLM_CALLS=2
MAX_RETRIEVAL_ROUNDS=1
RETRIEVAL_TOP_K_PER_QUESTION=5
MAX_EVIDENCE_CHUNKS=16
MAX_EVIDENCE_TOKENS=6000
# Counted input ceiling for explicit strict chat; normal chat records reported usage.
MAX_TOTAL_INPUT_TOKENS=16000
MAX_TOTAL_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT_SECONDS=30
RETRIEVAL_CONCURRENCY=4
MAX_REQUEST_BODY_BYTES=131072
READINESS_TIMEOUT_SECONDS=2
SHUTDOWN_TIMEOUT_SECONDS=5

# Ingestion bounds; fetch approved public pages only.
WEBSITE_BASE_URL=https://telescopecenter.com/
CRAWL_ALLOWED_HOSTS=telescopecenter.com,www.telescopecenter.com
CRAWL_MAX_PAGES=250
CRAWL_MAX_DEPTH=4
CRAWL_CONCURRENCY=2
CRAWL_DELAY_SECONDS=1
CRAWL_MAX_PAGE_BYTES=2000000
# Preserve source structure; tokens are a safety ceiling, not a target chunk size.
CHUNKING_STRATEGY=structure_aware
CHUNK_MAX_TOKENS=1200
KNOWLEDGE_MAX_AGE_HOURS=168

# External tracing disabled by default; do not record conversations.
LANGSMITH_TRACING=false
